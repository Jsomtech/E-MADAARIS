# ── Frontend (Vite) ──
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ── Backend ──
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (optional provider; leave blank to log invitation links) ──
# EMAIL_PROVIDER: resend (needs EMAIL_API_KEY) — otherwise mail is only printed to the server log.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@e-madaaris.com
# Account confirmation link lifetime in seconds (15 minutes .. 30 days; blank = 7 days).
EMAIL_VERIFICATION_EXPIRY=

# ── Payment integration (only when provider credentials are configured) ──
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Application ──
APP_BASE_URL=http://localhost:5173
JWT_AUDIENCE=authenticated
PLATFORM_SUPPORT_EMAIL=support@e-madaaris.com

# ── First Super Admin (used only by `npm run db:seed -w server`) ──
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Super Admin

# ── Credential vault (AES-256-GCM key for admin-visible issued passwords) ──
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
