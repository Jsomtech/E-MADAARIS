# ── Frontend (Vite) ──
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ── Backend ──
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (optional provider; leave blank to log invitation links) ──
# EMAIL_PROVIDER: resend (needs an API key) — otherwise mail is only printed to the server log.
# EMAIL_API_KEY and RESEND_API_KEY are both accepted; Resend's own docs call it RESEND_API_KEY.
# Testing without a verified domain: EMAIL_FROM=E-MADAARIS <onboarding@resend.dev> delivers only to
# the address on your Resend account.
EMAIL_PROVIDER=
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=no-reply@e-madaaris.com
# Account confirmation link lifetime in seconds (15 minutes .. 30 days; blank = 7 days).
EMAIL_VERIFICATION_EXPIRY=

# ── Payment integration (only when provider credentials are configured) ──
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Application ──
APP_BASE_URL=http://localhost:5173
JWT_AUDIENCE=authenticated
PLATFORM_SUPPORT_EMAIL=support@e-madaaris.com

# ── First Super Admin (used only by `npm run db:seed -w server`) ──
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Super Admin

# ── Credential vault (AES-256-GCM key for admin-visible issued passwords) ──
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# ── Firebase Cloud Messaging (server-side push) ──
# Firebase Console → Project settings → Service accounts → "Generate new private key".
# Keep the downloaded JSON OUT of the repository and give its location here. The server reads the file
# only when it sends a push, and never logs its contents. GOOGLE_APPLICATION_CREDENTIALS works too.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional. The project id inside the JSON is used when this is blank.
FIREBASE_PROJECT_ID=
