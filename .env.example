# ── Frontend (Vite) ──
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ── Backend ──
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (optional provider; leave blank to log invitation links) ──
# EMAIL_PROVIDER: resend (needs an API key) — otherwise mail is only printed to the server log.
# EMAIL_API_KEY and RESEND_API_KEY are both accepted; Resend's own docs call it RESEND_API_KEY.
# Testing without a verified domain: EMAIL_FROM=E-MADAARIS <onboarding@resend.dev> delivers only to
# the address on your Resend account.
EMAIL_PROVIDER=
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=no-reply@e-madaaris.com
# Account confirmation link lifetime in seconds (15 minutes .. 30 days; blank = 7 days).
EMAIL_VERIFICATION_EXPIRY=

# ── Payment integration (only when provider credentials are configured) ──
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Application ──
APP_BASE_URL=http://localhost:5173
JWT_AUDIENCE=authenticated
PLATFORM_SUPPORT_EMAIL=support@e-madaaris.com

# ── First Super Admin (used only by `npm run db:seed -w server`) ──
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Super Admin

# ── Credential vault (AES-256-GCM key for admin-visible issued passwords) ──
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# ── Scheduled jobs (serverless hosts only) ──
# A persistent process runs its own setInterval schedulers; on Vercel the platform's cron calls
# POST /api/v1/jobs/tick and /jobs/backups instead and proves itself with this value, sent as
# `Authorization: Bearer <CRON_SECRET>`. Without it those routes answer 503 and nothing is scheduled.
# Generate once: node -p "require('crypto').randomBytes(32).toString('hex')"
CRON_SECRET=

# ── Firebase Cloud Messaging (server-side push) ──
# Firebase Console → Project settings → Service accounts → "Generate new private key".
# Keep the downloaded JSON OUT of the repository and give its location here. The server reads the file
# only when it sends a push, and never logs its contents. GOOGLE_APPLICATION_CREDENTIALS works too.
FIREBASE_SERVICE_ACCOUNT_PATH=
# The same JSON as one value, for hosts with no readable file (Vercel, any serverless function). Takes
# priority over the path. Set one of the two, not both.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional. The project id inside the JSON is used when this is blank.
FIREBASE_PROJECT_ID=

# ── Web Push / VAPID (iPhone, iPad and any browser without Firebase) ──
# FCM reaches Chrome and Firefox on Android and desktop. Apple does not run FCM in Safari, so a device
# added to the Home Screen is reached over standards-based Web Push instead, which signs every request
# with a VAPID key pair. Mint one — it writes the private half straight into .env and prints only the
# public half, which is served to browsers by GET /api/v1/account/push-public-key:
#   npm run push:vapid -w server
# Do not regenerate an existing pair: every subscription registered under the old key dies silently.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services use to reach the sender if a subscription misbehaves.
VAPID_SUBJECT=mailto:no-reply@e-madaaris.com
# Seconds an undelivered push stays queued at the push service. 4 weeks is the maximum they honour.
PUSH_TTL_SECONDS=3600
