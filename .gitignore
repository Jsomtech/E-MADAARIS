# Dependencies
node_modules/

# Build output
dist/
client/dist/

# Real environment secrets — only .env.example files are committed
.env
.env.*
client/.env
client/.env.*
!.env.example
!client/.env.example

# Runtime logs
*.log
server.err

# Vercel link + pulled env (project id, org id — not secrets, but per-machine)
.vercel

# Firebase server credentials — the sender reads the file path from .env, the file never belongs in git
serviceAccount*.json
*service-account*.json
*firebase-admin*.json

# Scratch probes
server/tmp-*
server/*.tmp.mjs

# OS / editor noise
.DS_Store
Thumbs.db

.vercel
.env*
