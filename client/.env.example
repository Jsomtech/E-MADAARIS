# Copy to .env and fill from Firebase Console → Project settings → Your apps → Web app config.
# These values are public identifiers (not secrets) and are bundled into the client.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console → Cloud Messaging → Web configuration → Web Push certificates.
VITE_FIREBASE_VAPID_KEY=
